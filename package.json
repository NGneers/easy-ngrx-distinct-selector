{
  "name": "@ngneers/easy-ngrx-distinct-selector",
  "version": "21.0.0",
  "description": "Provides functions to easily create @ngrx/store selectors with equal functions for arguments and result values.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaSch0212/easy-ngrx-distinct-selector.git"
  },
  "author": {
    "name": "Marc Schmidt (MaSch0212) @ NGneers",
    "url": "https://github.com/NGneers"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./esm/index.js"
    }
  },
  "prettier": "@ngneers/prettier-config",
  "scripts": {
    "lint": "pnpm eslint ./src/** ./tools/**",
    "format": "prettier --write ./src/** ./tools/**",
    "format:check": "prettier --check ./src/** ./tools/**",
    "test": "ng test --no-watch",
    "test:watch": "ng test --watch",
    "prebuild": "pnpm rimraf dist",
    "postbuild": "tsx ./tools/post-build.ts",
    "build": "pnpm prebuild && pnpm build-esm",
    "build-base": "tsc -p ./tsconfig.lib.json",
    "build-esm": "pnpm build-base --outDir dist/esm"
  },
  "keywords": [
    "@ngrx",
    "ngrx",
    "@ngrx/store",
    "selector",
    "distinct",
    "distinctUntilChanged",
    "equal"
  ],
  "peerDependencies": {
    "@ngrx/effects": "22",
    "@ngrx/store": "22"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@ngneers/eslint-config": "^2.1.0",
    "@ngneers/prettier-config": "^1.1.0",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "immer": "^11.2.10",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "zone.js": "^0.16.3"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
